@model BecomeHostViewModel
@{
    ViewData["Title"] = "Add New Property";
}

<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">

        <a asp-action="Index" class="text-decoration-none small"><i class="fa-solid fa-arrow-left me-1"></i>Back to my properties</a>

        <p class="text-muted mt-3">
            An Admin reviews every new listing before guests can see it. At least one photo is required.
        </p>

        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <partial name="_PropertyFormFields" model="Model" />

            <section class="form-section">
                <h2 class="form-section-title"><span class="section-number">5</span> Add photos <span class="badge bg-danger ms-2">Required</span></h2>

                <p class="text-muted small">
                    Upload 1 to @UploadRules.MaxImages photos (JPG, PNG or WEBP, up to 5 MB each). The first photo becomes the cover image.
                </p>

                <input type="file" name="Images" class="form-control"
                       accept=".jpg,.jpeg,.png,.webp" multiple required
                       data-max="@UploadRules.MaxImages" data-max-mb="5"
                       data-preview="#previewGrid" data-message="#imageMessage" />
                       r
                <div id="imageMessage" class="text-danger small mt-2"></div>

                @if (ViewData.ModelState.TryGetValue("Images", out var imageState) && imageState.Errors.Count > 0)
                {
                    <ul class="text-danger small mt-2 mb-0">
                        @foreach (var error in imageState.Errors)
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                    <div class="text-muted small mt-1">Please select your photos again. Browsers clear file choices after an error.</div>
                }

                <div id="previewGrid" class="preview-grid"></div>
            </section>

            <div class="d-flex gap-2 justify-content-end mb-5">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-danger px-4">Submit for review</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/image-picker.js" asp-append-version="true"></script>
}