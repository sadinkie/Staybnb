@model EditPropertyViewModel
@{
    ViewData["Title"] = "Edit property";
}

<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">

        <a asp-action="Index" class="text-decoration-none small"><i class="fa-solid fa-arrow-left me-1"></i>Back to my properties</a>

        <form asp-action="Edit" method="post" enctype="multipart/form-data" class="mt-3">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="Id" />

            <partial name="_PropertyFormFields" model="Model" />

            <section class="form-section">
                <h2 class="form-section-title"><span class="section-number">5</span> Photos</h2>

                <p class="text-muted small">
                    Tick a photo to remove it. A listing needs at least one photo and can have up to @UploadRules.MaxImages.
                    The first photo is the cover image.
                </p>

                <div class="preview-grid mb-3">
                    @foreach (var image in Model.ExistingImages)
                    {
                        <label class="preview-tile remove-tile">
                            <img src="@image.Url" alt="Property photo" />
                            <span class="remove-check">
                                <input type="checkbox" name="RemoveImageIds" value="@image.Id" /> Remove
                            </span>
                        </label>
                    }
                </div>

                <label class="form-label">Add more photos</label>
                <input type="file" name="Images" class="form-control"
                       accept=".jpg,.jpeg,.png,.webp" multiple
                       data-max="@UploadRules.MaxImages" data-max-mb="5"
                       data-preview="#previewGrid" data-message="#imageMessage" />

                <div id="imageMessage" class="text-danger small mt-2"></div>
                <div id="previewGrid" class="preview-grid"></div>
            </section>

            <div class="d-flex gap-2 justify-content-end mb-5">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-danger px-4">Save changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/image-picker.js" asp-append-version="true"></script>
}