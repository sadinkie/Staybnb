@model List<HostPropertyListItem>
@{
    ViewData["Title"] = "My Properties";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <p class="text-muted mb-0">@Model.Count @(Model.Count == 1 ? "property" : "properties")</p>
    <a asp-action="Create" class="btn btn-danger">
        <i class="fa-solid fa-plus me-1"></i>Add New Property
    </a>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <div class="display-6 mb-2">🏡</div>
        <h2 class="h5">No properties yet</h2>
        <p class="text-muted">Add your first property to start hosting.</p>
        <a asp-action="Create" class="btn btn-danger">Add New Property</a>
    </div>
}

@foreach (var p in Model)
{
    <article class="host-prop">
        <div class="host-prop-image">
            <img src="@(p.ThumbnailUrl ?? PlaceholderImage.UrlFor(0))" alt="@p.Title" />
            <span class="img-count"><i class="fa-solid fa-camera"></i> @p.ImageCount</span>
        </div>

        <div class="host-prop-body">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <div class="min-w-0">
                    <h2 class="h5 mb-1">@p.Title</h2>
                    <div class="text-muted small">
                        <i class="fa-solid fa-location-dot me-1"></i>@p.City, @p.Country
                    </div>
                </div>
                <div class="text-end flex-shrink-0">
                    <div class="fw-bold">@Money.Rand(p.PricePerNight, cents: true)<span class="text-muted fw-normal small"> / night</span></div>
                </div>
            </div>

            <div class="prop-facts text-muted small mt-2">
                <span><i class="fa-solid fa-user-group me-1"></i>@p.MaxGuests guests</span>
                <span><i class="fa-solid fa-bed me-1"></i>@p.Bedrooms bedrooms</span>
                <span>@p.Beds beds</span>
                <span><i class="fa-solid fa-bath me-1"></i>@p.Bathrooms bathrooms</span>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-2">
                <span class="status-badge status-neutral">@p.PropertyType</span>
                <span class="status-badge @p.StatusClass">@p.StatusLabel</span>
            </div>

            @if (p.IsRejected && !string.IsNullOrWhiteSpace(p.AdminNotes))
            {
                <div class="admin-note"><strong>Reviewer's note:</strong> @p.AdminNotes</div>
            }

            <div class="host-prop-footer">
                <div class="text-muted small">
                    <i class="fa-solid fa-calendar-check me-1"></i>@p.BookingCount @(p.BookingCount == 1 ? "booking" : "bookings")
                    <span class="mx-2">&middot;</span>
                    <i class="fa-solid fa-star me-1"></i>@p.RatingText
                </div>

                <div class="d-flex flex-wrap gap-2">
                    @if (p.IsApproved)
                    {
                        <a class="btn btn-sm btn-outline-secondary" href="/Properties/View/@p.Id">
                            <i class="fa-solid fa-eye me-1"></i>View
                        </a>
                    }

                    @if (!p.IsRejected)
                    {
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@p.Id">
                            <i class="fa-solid fa-pen me-1"></i>Edit
                        </a>
                    }

                    @if (p.IsApproved)
                    {
                        <form asp-action="ToggleActive" asp-route-id="@p.Id" method="post">
                            <button type="submit" class="btn btn-sm @(p.IsActive ? "btn-danger" : "btn-outline-success")">
                                <i class="fa-solid @(p.IsActive ? "fa-power-off" : "fa-play") me-1"></i>@(p.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                    else if (p.IsPending)
                    {
                        <span class="text-muted small align-self-center">Awaiting Admin approval</span>
                    }
                </div>
            </div>
        </div>
    </article>
}