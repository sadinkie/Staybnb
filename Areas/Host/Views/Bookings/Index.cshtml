@using Staybnb.Enums
@using Staybnb.Models
@using Staybnb.Services
@model List<Booking>

@{
    ViewData["Title"] = "Booking Requests";
}

<div class="panel p-4 mb-4">
    <h2 class="h4 text-danger fw-bold mb-1">
        Booking Requests
    </h2>
    <p class="text-muted mb-0">
        Review and manage reservations for your properties.
    </p>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="panel">
    <div class="panel-head">
        <span>All Booking Requests (@Model.Count)</span>
    </div>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Guest</th>
                    <th>Property</th>
                    <th>Dates</th>
                    <th>Guests</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">
                                @booking.Guest.FirstName
                                @booking.Guest.LastName
                            </div>
                            <div class="text-muted small">
                                @booking.Guest.Email
                            </div>
                        </td>

                        <td>@booking.Property.Title</td>

                        <td class="text-nowrap">
                            @booking.CheckInDate.ToString("d MMM yyyy")
                            -
                            @booking.CheckOutDate.ToString("d MMM yyyy")
                        </td>

                        <td>@booking.NumberOfGuests</td>

                        <td>@Money.Rand(booking.TotalPrice)</td>

                        <td>
                            <span class="status-badge @BadgeStyle.For(booking.Status)">
                                @booking.Status
                            </span>
                        </td>

                        <td>
                            @if (booking.Status == BookingStatus.Pending)
                            {
                                <div class="d-flex gap-2">
                                    <form asp-area="Host"
                                          asp-controller="Bookings"
                                          asp-action="Approve"
                                          asp-route-id="@booking.Id"
                                          method="post">
                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-success btn-sm">
                                            Approve
                                        </button>
                                    </form>

                                    <form asp-area="Host"
                                          asp-controller="Bookings"
                                          asp-action="Reject"
                                          asp-route-id="@booking.Id"
                                          method="post">
                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm"
                                                onclick="return confirm('Reject this booking?');">
                                            Reject
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted small">
                                    No action required
                                </span>
                            }
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7"
                            class="text-center text-muted py-4">
                            No booking requests yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
