@model HostRequestDetailsViewModel
@{
    ViewData["Title"] = "Review application";
    var isPending = Model.Status == ApplicationStatus.Pending;
}

<a asp-action="Index" class="text-decoration-none small"><i class="fa-solid fa-arrow-left me-1"></i>Back to applications</a>

<div class="row g-4 mt-1">

    <!-- Property -->
    <div class="col-lg-8">
        <div class="panel p-4">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <h2 class="h4 mb-1">@Model.Title</h2>
                    <div class="text-muted">
                        <i class="fa-solid fa-location-dot me-1"></i>@Model.Address, @Model.City, @Model.Country
                    </div>
                </div>
                <span class="status-badge @BadgeStyle.For(Model.Status)">@Model.Status</span>
            </div>

            <div class="review-gallery my-4">
                @foreach (var image in Model.Images)
                {
                    <a href="@image" target="_blank"><img src="@image" alt="@Model.Title" /></a>
                }
            </div>

            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3"><div class="fact"><span>Type</span>@Model.PropertyType</div></div>
                <div class="col-6 col-md-3"><div class="fact"><span>Price per night</span>@Money.Rand(Model.PricePerNight)</div></div>
                <div class="col-6 col-md-3"><div class="fact"><span>Cleaning fee</span>@Money.Rand(Model.CleaningFee)</div></div>
                <div class="col-6 col-md-3"><div class="fact"><span>Guests</span>@Model.MaxGuests</div></div>
                <div class="col-4 col-md-3"><div class="fact"><span>Bedrooms</span>@Model.Bedrooms</div></div>
                <div class="col-4 col-md-3"><div class="fact"><span>Beds</span>@Model.Beds</div></div>
                <div class="col-4 col-md-3"><div class="fact"><span>Bathrooms</span>@Model.Bathrooms</div></div>
            </div>

            <h3 class="h6">Description</h3>
            <p style="white-space: pre-line">@Model.Description</p>

            <h3 class="h6 mt-4">Amenities</h3>
            @if (Model.Amenities.Any())
            {
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var amenity in Model.Amenities)
                    {
                        <span class="type-chip"><i class="@amenity.IconClass"></i> @amenity.Name</span>
                    }
                </div>
            }
            else
            {
                <p class="text-muted small mb-0">No amenities selected.</p>
            }
        </div>
    </div>

    <!-- Applicant and decision -->
    <div class="col-lg-4">
        <div class="panel p-4 mb-4">
            <h3 class="h6 mb-3">Applicant</h3>
            <div class="fw-semibold">@Model.ApplicantName</div>
            <div class="text-muted small">@Model.ApplicantEmail</div>
            <div class="text-muted small mt-2">Member since @Model.ApplicantJoined.ToLocalTime().ToString("d MMM yyyy")</div>
            <div class="text-muted small">Applied @Model.AppliedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")</div>
            @if (Model.IsAdditional)
            {
                <span class="badge bg-info-subtle text-info-emphasis mt-2">Additional property from an existing Host</span>
            }
        </div>

        @if (isPending)
        {
            <div class="panel p-4 mb-4">
                <h3 class="h6">Approve</h3>
                <p class="small text-muted">
                    @if (Model.IsAdditional)
                    {
                        <text>This listing goes live straight away. The applicant is already a Host.</text>
                    }
                    else
                    {
                        <text>The applicant becomes a <strong>Host</strong> and <strong>loses the Guest role</strong>. The listing goes live.</text>
                    }
                </p>
                <form asp-action="Approve" asp-route-id="@Model.ApplicationId" method="post"
                      onsubmit="return confirm('Approve this application?');">
                    <button type="submit" class="btn btn-success w-100">
                        <i class="fa-solid fa-circle-check me-1"></i>Approve application
                    </button>
                </form>
            </div>

            <div class="panel p-4">
                <h3 class="h6">Reject</h3>
                <form asp-action="Reject" asp-route-id="@Model.ApplicationId" method="post">
                    <label for="notes" class="form-label small text-muted">Reason (the applicant will see this)</label>
                    <textarea id="notes" name="notes" class="form-control mb-3" rows="4" maxlength="500" required
                              placeholder="e.g. Please add clearer photos of the bedrooms."></textarea>
                    <button type="submit" class="btn btn-outline-danger w-100">
                        <i class="fa-solid fa-circle-xmark me-1"></i>Reject application
                    </button>
                </form>
            </div>
        }
        else
        {
            <div class="panel p-4">
                <h3 class="h6">Decision</h3>
                <p class="mb-1"><span class="status-badge @BadgeStyle.For(Model.Status)">@Model.Status</span></p>
                @if (Model.ReviewedAt.HasValue)
                {
                    <div class="text-muted small">@Model.ReviewedAt.Value.ToLocalTime().ToString("d MMM yyyy, HH:mm")</div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.AdminNotes))
                {
                    <div class="admin-note"><strong>Note:</strong> @Model.AdminNotes</div>
                }
            </div>
        }
    </div>
</div>