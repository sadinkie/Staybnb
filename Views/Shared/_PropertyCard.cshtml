@model PropertyCardViewModel
@{
    var carouselId = $"carousel-{Model.Id}";
    var images = Model.ImageUrls.Any()
        ? Model.ImageUrls
        : new List<string> { PlaceholderImage.UrlFor(0) };
    var detailsUrl = $"/Properties/View/{Model.Id}";
}

<article class="prop-card">
    <div id="@carouselId" class="carousel slide prop-carousel" data-bs-interval="false">
        <div class="carousel-inner">
            @for (var i = 0; i < images.Count; i++)
            {
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <a href="@detailsUrl">
                        <img src="@images[i]" class="prop-img" alt="@Model.Title" loading="lazy" />
                    </a>
                </div>
            }
        </div>

        @if (images.Count > 1)
        {
            <button class="carousel-control-prev" type="button" data-bs-target="#@carouselId" data-bs-slide="prev" aria-label="Previous photo">
                <span class="carousel-arrow"><i class="fa-solid fa-chevron-left"></i></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#@carouselId" data-bs-slide="next" aria-label="Next photo">
                <span class="carousel-arrow"><i class="fa-solid fa-chevron-right"></i></span>
            </button>
            <div class="img-count"><i class="fa-solid fa-camera"></i> @images.Count</div>
        }
    </div>

    <a href="@detailsUrl" class="prop-info">
        <div class="d-flex justify-content-between gap-2">
            <span class="prop-title">@Model.Title</span>
            <span class="prop-rating"><i class="fa-solid fa-star"></i> @Model.RatingText</span>
        </div>
        <div class="prop-meta">@Model.City, @Model.Country</div>
        <div class="prop-meta">@Model.PropertyType &middot; up to @Model.MaxGuests guests</div>
        <div class="prop-price"><strong>@Money.Rand(Model.PricePerNight)</strong> <span>night</span></div>
    </a>
</article>