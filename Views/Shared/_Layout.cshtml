<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Staybnb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var isAuthenticated = User.Identity?.IsAuthenticated == true;
    }

    <header class="stay-nav">
        <div class="container-xl d-flex align-items-center justify-content-between">

            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-house-chimney"></i> staybnb
            </a>

            <a class="search-pill d-none d-md-flex" asp-area="" asp-controller="Home" asp-action="Index">
                <span>Anywhere</span>
                <span>Any week</span>
                <span>Add guests</span>
                <span class="search-btn"><i class="fa-solid fa-magnifying-glass"></i></span>
            </a>

            <div class="d-flex align-items-center gap-2">
                @if (isAuthenticated)
                {
                    if (User.IsInRole("Guest"))
                    {
                        <a class="nav-link-plain d-none d-lg-inline" href="/BecomeHost/Status">Host Application Status</a>
                        <a class="nav-link-plain fw-semibold d-none d-lg-inline" href="/BecomeHost">Become a Host</a>
                    }
                    else if (User.IsInRole("Host"))
                    {
                        <a class="nav-link-plain fw-semibold" asp-area="Host" asp-controller="Dashboard" asp-action="Index">Host Dashboard</a>
                    }
                    else
                    {
                        <a class="nav-link-plain fw-semibold" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin Dashboard</a>
                    }

                    <div>@await Component.InvokeAsync("TopBar")</div>
                }
                else
                {
                    <a class="nav-link-plain" asp-area="" asp-controller="Account" asp-action="Login">Log in</a>
                    <a class="btn btn-danger btn-sm px-3" asp-area="" asp-controller="Account" asp-action="Register">Sign up</a>
                }
            </div>
        </div>
    </header>

    <main role="main" class="container-xl py-4">
        <partial name="_Alerts" />
        @RenderBody()
    </main>

    <footer class="stay-footer">
        <div class="container-xl">&copy; @DateTime.Now.Year Staybnb &middot; A Programming 742 project</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>